---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getActivities, formatDate } from '../../lib/content';

const activities = await Promise.all(
  (await getActivities()).map(async (a) => ({ ...a, Content: (await render(a)).Content })),
);
---

<Base title="活動紀錄" description="電腦資訊社的活動紀錄。">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">// activities · {activities.length} 則</p>
      <h1>活動紀錄</h1>
      <p>社課、成果發表、比賽與出遊。</p>
    </header>

    <ol class="timeline" data-pagefind-body>
      {
        activities.map(({ id, data, Content }) => (
          <li class="item" id={id}>
            <div class="when mono">
              <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
              {data.location && <span class="where">{data.location}</span>}
            </div>
            <div class="what">
              <h2>{data.title}</h2>
              <div class="prose">
                <Content />
              </div>
              {data.photos.length > 0 && (
                <ul class="photos">
                  {data.photos.map((p) => (
                    <li>
                      <img src={p.src} alt={p.alt} loading="lazy" width="640" height="480" />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding-bottom: 3rem;
  }

  /* 時間軸的線與節點 */
  .item::before {
    content: '';
    position: absolute;
    left: 9.5rem;
    top: 0.5rem;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .item::after {
    content: '';
    position: absolute;
    left: calc(9.5rem - 4px);
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .item:last-child::before {
    display: none;
  }

  .when {
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
    color: var(--muted);
    padding-top: 0.15rem;
  }

  .where {
    color: var(--steel);
    font-size: 0.75rem;
  }

  .what {
    padding-left: 1.5rem;
    min-width: 0;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }

  .what .prose {
    color: var(--muted);
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  @media (max-width: 40rem) {
    .item {
      grid-template-columns: 1fr;
      padding-left: 1.5rem;
    }

    .item::before {
      left: 0.25rem;
    }

    .item::after {
      left: calc(0.25rem - 4px);
    }

    .when {
      flex-direction: row;
      gap: 0.75rem;
    }

    .what {
      padding-left: 0;
    }
  }
</style>
