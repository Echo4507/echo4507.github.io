---
// 深淺色切換按鈕：預設跟隨系統，按下後記住你的選擇
---

<button class="icon-btn theme-toggle" type="button" aria-label="切換深色模式" aria-pressed="false" title="切換深淺色">
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function apply(theme: string) {
    root.dataset.theme = theme;
    button?.setAttribute('aria-pressed', String(theme === 'dark'));
  }

  apply(root.dataset.theme ?? 'light');

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    apply(next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // 沒有手動選過時，系統深淺色改變就跟著改
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) apply(e.matches ? 'dark' : 'light');
  });
</script>

<style>
  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>
