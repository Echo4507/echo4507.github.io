---
import { site, nav } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.title} 首頁`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">~/{site.title}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="主選單">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href="/search/" aria-label="搜尋" title="搜尋">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <ThemeToggle />
      <button class="icon-btn menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="開啟選單">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // 手機版選單開關
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? '開啟選單' : '關閉選單');
    nav?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 3px;
    background: var(--metal);
    border: 1px solid var(--border-strong);
    box-shadow: inset -3px -3px 0 var(--accent);
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .nav a:hover {
    color: var(--text);
    background: var(--surface-2);
    text-decoration: none;
  }

  .nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .menu-btn {
    display: none;
  }

  /* 手機版：導覽列收進選單按鈕 */
  @media (max-width: 40rem) {
    .menu-btn {
      display: inline-flex;
    }

    .actions {
      margin-left: auto;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .nav.open {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      padding: 0.5rem var(--gutter) 1rem;
    }

    .nav a {
      padding: 0.7rem 0.5rem;
      font-size: 1rem;
    }

    .nav a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--accent);
      padding-left: 0.9rem;
    }
  }
</style>

<style is:global>
  /* 頁首的圓形圖示按鈕（ThemeToggle 也會用到） */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--border);
    background: var(--surface);
    text-decoration: none;
  }
</style>
